===== Bluetooth HCI sysfs and udev identity =====
COMMAND: bash -c $'\n  for hci in /sys/class/bluetooth/hci*; do\n    [[ -e $hci ]] || continue\n    printf "HCI=%s\\\\n" "$hci"\n    printf "DEVICE_PATH="\n    readlink -f "$hci/device" 2>/dev/null || true\n    udevadm info --query=all --path="$hci/device" 2>&1 || true\n    for attr in name type modalias; do\n      [[ -r $hci/$attr ]] || continue\n      printf "%s=" "$attr"\n      cat "$hci/$attr"\n    done\n  done\n'
