--- FILE ~/.config/quickshell/caelestia/components/controls/CustomMouseArea.qml | bytes=537 | sha256=76fb4fd1f8924acc82294fa5606f84bbf919f3fa79c7732d52ad7df5115aca7b ---
import QtQuick

MouseArea {
    property int scrollAccumulatedY: 0

    function onWheel(event: WheelEvent): void {
    }

    onWheel: event => {
        // Update accumulated scroll
        if (Math.sign(event.angleDelta.y) !== Math.sign(scrollAccumulatedY))
            scrollAccumulatedY = 0;
        scrollAccumulatedY += event.angleDelta.y;

        // Trigger handler and reset if above threshold
        if (Math.abs(scrollAccumulatedY) >= 120) {
            onWheel(event);
            scrollAccumulatedY = 0;
        }
    }
}
--- END FILE ~/.config/quickshell/caelestia/components/controls/CustomMouseArea.qml ---
